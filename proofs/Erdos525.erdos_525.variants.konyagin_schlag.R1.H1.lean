lemma zy (g n l e : b) (d0 : 0 ≤ e) (Uo : e ≤ 10) (Qb : e / 200 ≤ l) (Qc : l ≤ 1 / 2) : e ^ 2 / 500000 * (g ^ 2 + n ^ 2) ≤ (g * co l + n * ek l) ^ 2 + (g * co (-l) + n * ek (-l)) ^ 2 := by
